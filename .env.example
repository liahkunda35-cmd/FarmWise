# Copy to .env.local and fill in values. Never commit real secrets.

# Database (Neon Postgres)
IFMS_DB_DRIVER=pgsql
DATABASE_URL_POOLED=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production
PGHOST=
PGPORT=5432
PGDATABASE=neondb
PGUSER=
PGPASSWORD=
PGSSLMODE=require

# Optional: CA bundle for outbound HTTPS (Nexus email, APIs). Keep SSL verification ON.
# Use storage/certs/cacert.pem (Mozilla). If a corporate proxy (e.g. Sophos) intercepts TLS,
# append that proxy's CA PEM into storage/certs/cacert-with-local.pem and point here.
# IFMS_SSL_CAINFO=
# CURL_CA_BUNDLE=

# Set to 1 behind HTTPS (or rely on HTTPS / X-Forwarded-Proto) so session cookies are Secure.
# IFMS_SESSION_SECURE=0

# FarmWise AI Assistant — Google Gemini
# Get a key at https://aistudio.google.com/apikey
# Keep this server-side only (never VITE_/NEXT_PUBLIC_/browser bundles)
GEMINI_API_KEY=
# Preferred model. Under load the app automatically falls back to flash-lite models.
GEMINI_MODEL=gemini-3.8-flash
# Optional: set to 1 to use scripts/gemini-chat.mjs (Node). Default is PHP REST (more reliable timeouts).
GEMINI_USE_NODE=0

# OpenWeather — current conditions + 5-day / 3-hour forecast (Free plan endpoints)
# Get a key at https://home.openweathermap.org/api_keys
# Server-side only: never prefix with VITE_/NEXT_PUBLIC_ or ship to the browser
OPENWEATHER_API_KEY=

# Nexus transactional email (server-side only — never expose to the browser)
# Provider: nexuspromail (default) or wrnexus
# Premium/Enterprise (or a valid dashboard API key). Free plan often has no API key.
# Live send: POST {NEXUS_API_URL}/api/v1/api/send  Authorization: Bearer {NEXUS_API_KEY}
NEXUS_PROVIDER=nexuspromail
NEXUS_API_URL=https://app.nexuspromail.com
NEXUS_API_KEY=
# Required for NexusProMail sends — must be a provider-verified from address
NEXUS_FROM_EMAIL=
NEXUS_FROM_NAME=FarmWise
# Required when NEXUS_PROVIDER=wrnexus (create a sender credential in the Nexus dashboard)
NEXUS_SENDER_KEY=
# Prefer Nexus over SMTP when both are configured
NEXUS_PREFER=1
# Optional template credential IDs (leave blank to use built-in HTML/text bodies)
NEXUS_TEMPLATE_REGISTRATION_RECEIVED=
NEXUS_TEMPLATE_ACCOUNT_APPROVED=
NEXUS_TEMPLATE_ACCOUNT_REJECTED=
NEXUS_TEMPLATE_ACTIVATION=
NEXUS_TEMPLATE_PASSWORD_RESET=
