# Copy to .env.local and fill in values. Never commit real secrets.

# Database (Neon Postgres)
IFMS_DB_DRIVER=pgsql
DATABASE_URL_POOLED=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production
PGHOST=
PGPORT=5432
PGDATABASE=neondb
PGUSER=
PGPASSWORD=
PGSSLMODE=require

# FarmWise AI Assistant — Google Gemini
# Get a key at https://aistudio.google.com/apikey
# Keep this server-side only (never VITE_/NEXT_PUBLIC_/browser bundles)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
